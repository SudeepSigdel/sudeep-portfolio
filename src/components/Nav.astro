---
const links = [
  { id: 'about', n: '01', label: 'About' },
  { id: 'experience', n: '02', label: 'Experience' },
  { id: 'work', n: '03', label: 'Work' },
  { id: 'stack', n: '04', label: 'Stack' },
  { id: 'contact', n: '05', label: 'Contact' },
];
---

<nav class="nav" aria-label="Primary" data-nav>
  <div class="bar wrap">
    <a class="mono mark" href="#top" aria-label="Sudeep Sigdel, back to top">SS</a>
    <span class="mono label" data-label aria-hidden="true"></span>

    <button
      class="mono toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-links"
      data-toggle
    >
      Menu
    </button>

    <ul id="nav-links" class="mono links" data-links>
      {
        links.map((l) => (
          <li>
            <a href={`#${l.id}`} data-link={l.id} data-n={l.n} data-name={l.label}>
              <span class="n" aria-hidden="true">{l.n}</span>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <button class="mono theme" type="button" aria-pressed="false" data-theme-toggle>
      <svg class="icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        <path class="moon" d="M12.5 10.2A5.5 5.5 0 0 1 5.8 3.5a5.5 5.5 0 1 0 6.7 6.7Z" />
        <g class="sun"><circle cx="8" cy="8" r="3" /><path d="M8 1.5v1.6M8 12.9v1.6M1.5 8h1.6M12.9 8h1.6M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M3.4 12.6l1.1-1.1M11.5 4.5l1.1-1.1" /></g>
      </svg>
      <span class="to-night">Night</span>
      <span class="to-day">Day</span>
    </button>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    color: var(--parchment);
    transition:
      background-color 0.5s var(--ease),
      border-color 0.5s var(--ease);
    border-bottom: 1px solid transparent;
  }
  /* Over the pale sky the bar uses dark type; it flips to light on the solid bar and the open menu */
  .nav:not(.solid):not(.open) {
    color: var(--ink);
  }
  .nav:not(.solid):not(.open) :focus-visible {
    outline-color: var(--ink);
  }
  .nav.solid {
    background: var(--umber);
    border-bottom-color: rgb(241 233 214 / 0.14);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-height: 3.5rem;
  }
  a {
    text-decoration: none;
  }
  .mark {
    letter-spacing: 0.2em;
    padding-block: 0.9rem;
  }
  .label {
    opacity: 0;
    transition: opacity 0.5s var(--ease);
    color: var(--dust);
    white-space: nowrap;
  }
  .nav.solid .label {
    opacity: 1;
  }

  .links {
    display: flex;
    gap: clamp(1rem, 3vw, 2.25rem);
    list-style: none;
    margin: 0 0 0 auto;
    padding: 0;
  }
  .links a {
    display: inline-block;
    padding-block: 1rem;
    background: linear-gradient(currentColor, currentColor) 0 calc(100% - 0.7rem) / 0 1px no-repeat;
    transition: background-size 0.5s var(--ease);
  }
  .links a:hover,
  .links a:focus-visible,
  .links a[aria-current='true'] {
    background-size: 100% 1px;
  }
  .n {
    display: none;
  }
  .toggle {
    display: none;
  }

  /* Day / night switch: shown only once its script has attached, since before that it would do nothing */
  .theme {
    display: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 0.25rem;
    margin-left: clamp(0.5rem, 2vw, 1.25rem);
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
  }
  .theme[data-ready] {
    display: inline-flex;
  }
  .icon {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  .moon {
    fill: currentColor;
  }
  /* shows the destination (a moon while it is day, a sun while it is night), driven by the theme attribute so it is right from first paint */
  .sun,
  .to-day {
    display: none;
  }
  :global(:root[data-theme='night']) .moon,
  :global(:root[data-theme='night']) .to-night {
    display: none;
  }
  :global(:root[data-theme='night']) .sun {
    display: inline;
  }
  :global(:root[data-theme='night']) .to-day {
    display: inline;
  }

  /* Small screens: collapse links into a menu once JS is available */
  @media (max-width: 760px) {
    .theme {
      margin-left: 0.5rem;
    }
    :global(.js) .toggle {
      display: inline-flex;
      align-items: center;
      margin-left: auto;
      min-height: 2.75rem;
      padding: 0 0.25rem;
      background: none;
      border: 0;
      color: inherit;
      cursor: pointer;
    }
    :global(.js) .links {
      display: none;
      position: absolute;
      inset: 100% 0 auto 0;
      flex-direction: column;
      gap: 0;
      margin: 0;
      padding: 0.5rem var(--gutter) 1.25rem;
      background: var(--umber);
      border-bottom: 1px solid rgb(241 233 214 / 0.14);
    }
    :global(.js) .nav.open .links {
      display: flex;
    }
    :global(.js) .links a {
      display: flex;
      gap: 1rem;
      min-height: 3rem;
      align-items: center;
      padding-block: 0;
      background: none;
    }
    :global(.js) .links a[aria-current='true'] {
      color: var(--straw);
    }
    :global(.js) .n {
      display: inline;
      color: var(--dust);
    }
    :global(.js) .nav.open {
      background: var(--umber);
    }
    /* without JS, let the links wrap beneath the mark */
    .bar {
      flex-wrap: wrap;
    }
    .links {
      margin-left: 0;
      gap: 0.25rem 1.25rem;
    }
  }

  @media (max-width: 380px) {
    .label {
      display: none;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) {
    const label = nav.querySelector<HTMLElement>('[data-label]')!;
    const toggle = nav.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('[data-link]'));
    const hero = document.querySelector('.hero');

    // Solid bar once the hero has scrolled away
    if (hero && 'IntersectionObserver' in window) {
      new IntersectionObserver(
        ([e]) => nav.classList.toggle('solid', !e.isIntersecting),
        { rootMargin: '-56px 0px 0px 0px' },
      ).observe(hero);
    } else {
      nav.classList.add('solid');
    }

    // Current section: the one crossing the middle of the viewport
    const setActive = (id: string | null) => {
      for (const a of links) {
        if (a.dataset.link === id) {
          a.setAttribute('aria-current', 'true');
          label.textContent = `${a.dataset.n} / ${a.dataset.name}`;
        } else a.removeAttribute('aria-current');
      }
      if (!id) label.textContent = '';
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) if (e.isIntersecting) setActive(e.target.id);
        },
        { rootMargin: '-45% 0px -50% 0px' },
      );
      for (const a of links) {
        const s = document.getElementById(a.dataset.link!);
        if (s) io.observe(s);
      }
      if (hero)
        new IntersectionObserver(([e]) => e.isIntersecting && setActive(null), {
          rootMargin: '-45% 0px -50% 0px',
        }).observe(hero);
    }

    // Mobile menu
    const setOpen = (open: boolean) => {
      nav.classList.toggle('open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.textContent = open ? 'Close' : 'Menu';
    };
    toggle.addEventListener('click', () => setOpen(!nav.classList.contains('open')));
    for (const a of links) a.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('open')) {
        setOpen(false);
        toggle.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (nav.classList.contains('open') && !nav.contains(e.target as Node)) setOpen(false);
    });
    window.matchMedia('(min-width: 761px)').addEventListener('change', (m) => m.matches && setOpen(false));
  }

  // Day / night
  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (themeBtn) {
    const root = document.documentElement;
    const apply = (night: boolean, save: boolean) => {
      root.dataset.theme = night ? 'night' : 'day';
      themeBtn.setAttribute('aria-pressed', String(night));
      themeBtn.setAttribute('aria-label', night ? 'Night mode, on. Switch to day' : 'Night mode, off. Switch to night');
      document.querySelector<HTMLMetaElement>('meta[name=theme-color]')?.setAttribute('content', night ? '#0a0d0b' : '#1a170d');
      if (save) {
        try {
          localStorage.setItem('theme', night ? 'night' : 'day');
        } catch {
          /* private mode: the choice just lasts for this visit */
        }
      }
    };
    apply(root.dataset.theme === 'night', false);
    themeBtn.setAttribute('data-ready', '');
    themeBtn.addEventListener('click', () => apply(root.dataset.theme !== 'night', true));
    // follow the system until the visitor makes their own choice
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
      let saved: string | null = null;
      try {
        saved = localStorage.getItem('theme');
      } catch {}
      if (!saved) apply(e.matches, false);
    });
  }
</script>
